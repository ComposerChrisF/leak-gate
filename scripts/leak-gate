#!/usr/bin/env bash
# leak-gate: refuse a private reference in what a repository publishes: its tracked files, and its
# commit and tag messages.
#
# It scans one of three things:
#   the index    With no command: what is committed, or about to be.  Every tracked file's contents
#                and path, except the paths a tracked `.leak-gate-exclude` at the repository root
#                lists, one per line, each a file or a directory taken literally (blank lines and
#                lines starting with `#` are skipped), for files the repository never publishes; it
#                names them on stderr each run.  Without that file every tracked file is scanned,
#                and a new file is scanned by default, so the gate fails closed.  A binary file is
#                matched byte for byte, so text in it stored as UTF-16 or in a compressed stream is
#                not seen, and a home path or a private name in it is reported as the whole file.
#   a message    `message <file>`: every line of one commit message file, for a `commit-msg` hook.
#                git hands the hook the message before its cleanup, and the hook cannot tell which
#                lines git will keep: git keeps comment lines for `-m` and `-F`, and a `--cleanup`
#                flag is never visible to the hook.  So git's own comment lines, and the diff that
#                `git commit -v` adds, are read too, and a private name in a line git would drop
#                still refuses the commit: in an untracked file's name that git's template lists,
#                say, or in a line that `-v` shows being removed.  Commit with `-m` or `-F`, or
#                without `-v`, to avoid that.
#   a range      `range <revisions>`: the message of every commit that `git rev-list <revisions>`
#                lists, and of every annotated tag that points to one of them, through any tags it
#                points to, for CI over what a push adds; `range --all`, every ref's history, for
#                the scan before publishing.  The objects are read as a push sends them, replace
#                refs ignored.  Only the messages: the files at each commit are not read, so a
#                reference added and removed again within the range is not seen here.  In a
#                shallow clone, whose history stops early, `range` refuses to run.
# A NUL byte in a message is read as a line break.  Each finding is a line on stdout naming where it
# is: a path, `message`, `commit <abbreviated sha>`, or `tag <name>`.
#
# Two layers, each over what is scanned:
#   generic  Committed here, and run by CI and by the hooks: absolute home paths other than the
#            test fixtures' `alice` (`/Users/<name>`, `/home/<name>`, `C:\Users\<name>`; the
#            exception cannot apply to a binary file), paths into the home directory's `.claude`
#            folder (`~`, `$HOME`, or `${HOME}`), paths from the home directory into a folder that
#            is not a dot-folder (`~/<folder>`, `$HOME/<folder>`, `${HOME}/<folder>`, and Rust's
#            `env!("HOME")` followed on the same line by `, "/<folder>`: a dot-folder such as
#            `~/.config` names tool state, any other the owner's own files; the home directory
#            reached another way, such as `std::env::var("HOME")`, is not seen), and bug or plan
#            ID citations, in a file's
#            contents or path or in a message, that a history cut from its predecessor's cannot
#            resolve: an ID that is not four digits at or above its series' floor, or any ID of a
#            series with no floor.  An ID counts wherever it does not follow a letter or digit, so
#            `_` and a letter that is not ASCII separate it from what is before it.  A floor is
#            `bugs/FLOOR` or `plans/FLOOR`, a tracked regular file whose one line that is not blank
#            or a `#` comment names the series' lowest ID, above 0000.
#   private  Names that must not be published, so never committed: one extended regular
#            expression per line (a line starting with `#` is a comment, and a line's trailing
#            carriage return is dropped, so a list saved with CRLF line endings still matches),
#            matched as whole words (`_` separates words), ignoring case, in every tracked file's
#            contents and path, or in a message.  The list is the first of these that applies:
#              1. $LEAK_GATE_PATTERNS, which must exist (a relative value is read from the
#                 directory the gate is run in);
#              2. ~/.config/leak-gate/lists/<key>.txt, when the repository's `.leak-gate.toml`
#                 names it with `private-list = "<key>"`.  A list the repository names must
#                 exist and hold a pattern, or the gate stops with exit 4;
#              3. ~/.config/leak-gate/patterns.txt.  When it is absent the layer is skipped, with a
#                 notice on stderr.
#            --generic-only skips the layer, whatever names a list.
#
# Settings: a tracked `.leak-gate.toml` at the repository root, read from the index.  It is a
# small part of TOML: one `key = value` per line, a value being a string in double quotes or a list
# of them in `[ ]` on the same line, each holding no `"`, `\`, `#`, or control character, with
# blank lines and `#` comments.  The keys:
#   private-list = "<key>"        The private list, above.  A list's key is letters, digits, `.`,
#                                 `_`, and `-`, starting with a letter or digit.  It is published
#                                 with the file, so it must not itself be private.
#   refuse-extensions = ["<ext>"] Refuse every tracked file whose name ends in `.<ext>`, ignoring
#                                 case, in the generic layer, so CI refuses it too.  An extension is
#                                 written without its first dot (`sib`, `tar.gz`), in the
#                                 characters of a list's key.  Only the name is read: a file of
#                                 that kind under another name is not seen.
#   allow-under = ["<folder>"]    Except a file below one of these folders: each a path from the
#                                 repository root, with no empty, `.`, or `..` part (a trailing `/`
#                                 is dropped).
# Any other key, a key set twice, a value of the wrong kind or not in its form, a line not in this
# form, or a `.leak-gate.toml` that is not a regular file stops the gate: a setting it could not
# read must never pass as no setting.
#
# Usage: leak-gate [--require-private | --generic-only] [message <file> | range <revisions>]
#        leak-gate --help
#   --require-private  An absent default list, or an empty list, is exit 4, not a notice.  Use it
#                      for the final scans before publishing: the index, and `range --all`.
#   --generic-only     Run the generic layer alone, and say so on stderr.  Use it in CI, where no
#                      private list is.
#   message <file>     Scan a commit message.  A relative <file> is read from the directory the
#                      gate is run in.
#   range <revisions>  Scan the messages in a range, as `git rev-list` takes one: `A..B`, or
#                      `<rev>^!` for a single commit; or `--all`.
#   --help             Print this text.
#
# Exit: 0 clean; 1 the gate itself failed (git, grep, or perl; a pattern file it cannot read or
#       that $LEAK_GATE_PATTERNS names and is not there; a floor or a `.leak-gate.toml` not in the
#       form above; exclusions that leave nothing to scan; a message file it cannot read; or
#       revisions git cannot list); 2 usage error; 3 findings; 4 setup needed: no private patterns,
#       with --require-private or from a list the repository names, or `range` in a shallow clone.

set -uo pipefail

usage="usage: leak-gate [--require-private | --generic-only] [message <file> | range <revisions>]"
require_private=0 generic_only=0 command=index target=""
case ${1-} in
    --require-private) require_private=1; shift ;;
    --generic-only) generic_only=1; shift ;;
    --help)
        [ $# -eq 1 ] || { echo "leak-gate: --help takes no other argument" >&2; exit 2; }
        sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
esac
case $# in
    0) ;;
    2) case $1 in
           message | range) command=$1 target=$2 ;;
           *) echo "leak-gate: unknown command: $1; $usage" >&2; exit 2 ;;
       esac ;;
    *) echo "leak-gate: unexpected arguments: $*; $usage" >&2; exit 2 ;;
esac
case $command:$target in
    message: | range:) echo "leak-gate: $command needs a non-empty argument; $usage" >&2; exit 2 ;;
    range:--all) ;;
    range:-*) echo "leak-gate: range takes revisions or --all, not another option: $target" >&2; exit 2 ;;
esac

# A message file is the caller's, read from the caller's directory, so it is resolved before the cd
# below.
if [ "$command" = message ]; then
    case $target in /*) ;; *) target=$PWD/$target ;; esac
fi

# A list set in $LEAK_GATE_PATTERNS is the caller's: it must exist, and a relative value is read
# from the caller's directory, so it is resolved before the cd below.
if [ -n "${LEAK_GATE_PATTERNS:-}" ]; then
    explicit=1
    case $LEAK_GATE_PATTERNS in
        /*) list=$LEAK_GATE_PATTERNS ;;
        *) list=$PWD/$LEAK_GATE_PATTERNS ;;
    esac
else
    explicit=0
    list=$HOME/.config/leak-gate/patterns.txt
fi

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

# Sets $tracked to 1 when a path is tracked, $mode to its mode in the index, and $content to its
# text there; or $tracked to 0 and the others to nothing.
read_tracked() {
    local listed
    listed=$(git ls-files --cached --stage -- "$1") || { echo "leak-gate: git ls-files failed" >&2; exit 1; }
    tracked=0 mode="" content=""
    [ -n "$listed" ] || return 0
    tracked=1
    mode=${listed%% *}
    content=$(git show ":$1") || { echo "leak-gate: cannot read $1 from the index" >&2; exit 1; }
}

# Sets $lines to the lines of $content that are neither blank nor a `#` comment.
significant() {
    lines=$(grep -v -E '^[[:space:]]*(#|$)' <<<"$content")
    [ $? -le 1 ] || { echo "leak-gate: grep failed" >&2; exit 1; }
}

# The repository's settings, in the header's form, or the gate stops.  The blob goes to perl as it
# is: bash would drop a NUL from it, and could turn a corrupt file into an empty one.
list_key="" refuse_exts="" allow_dirs=""
read_tracked .leak-gate.toml
if [ "$tracked" -eq 1 ]; then
    case $mode in
        100644 | 100755) ;;
        *) echo "leak-gate: .leak-gate.toml is not a regular file" >&2; exit 1 ;;
    esac
    settings=$(git show ":.leak-gate.toml" | perl -e '
        my %kind = ("private-list" => "string", "refuse-extensions" => "list", "allow-under" => "list");
        my $where = ".leak-gate.toml line";
        my ($n, %seen) = (0);
        while (my $line = <STDIN>) {
            $n++;
            chomp $line;
            # No value holds a "#", so the first one starts a comment.
            (my $body = $line) =~ s/#.*//s;
            next if $body =~ /^\s*$/;
            my ($key, $raw) = $body =~ /^\s*([A-Za-z0-9_-]+)\s*=\s*(.*?)\s*$/
                or die "leak-gate: $where $n is not in the form key = value\n";
            exists $kind{$key} or die "leak-gate: $where $n: unknown key $key\n";
            $seen{$key}++ and die "leak-gate: $where $n: $key is set twice\n";
            my $item = qr/"[^"\\\x00-\x1f\x7f]*"/;
            my @values;
            if ($kind{$key} eq "string") {
                $raw =~ /^$item$/ or die "leak-gate: $where $n: $key takes one string in double quotes\n";
                @values = ($raw);
            } else {
                $raw =~ /^\[\s*(?:$item\s*(?:,\s*$item\s*)*,?\s*)?\]$/
                    or die "leak-gate: $where $n: $key takes a list of strings in [ ], on one line\n";
                @values = $raw =~ /($item)/g;
            }
            for my $v (@values) {
                $v = substr($v, 1, -1);
                if ($key eq "allow-under") {
                    $v =~ s{/+$}{};
                    my @parts = split m{/}, $v, -1;
                    ($v ne "" && !grep { $_ eq "" || $_ eq "." || $_ eq ".." } @parts)
                        or die "leak-gate: $where $n: a folder is a path from the repository root, with no empty, ., or .. part\n";
                } else {
                    $v =~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/
                        or die "leak-gate: $where $n: $key takes letters, digits, ., _, and -, starting with a letter or digit\n";
                }
                print "$key\t$v\n";
            }
        }') || exit 1
    while IFS=$'\t' read -r key value; do
        case $key in
            private-list) list_key=$value ;;
            refuse-extensions) refuse_exts+="$value"$'\n' ;;
            allow-under) allow_dirs+="$value"$'\n' ;;
        esac
    done <<<"$settings"
fi

# A list the repository names takes the place of the default, and must hold a pattern.
named=0
if [ "$explicit" -eq 0 ] && [ -n "$list_key" ]; then
    named=1
    list=$HOME/.config/leak-gate/lists/$list_key.txt
fi

# Sets $floor to the ID number a tracked <series>/FLOOR names, or above every ID when the series
# has none, so that each of its IDs is refused.  A tracked floor that is not in the header's form
# stops the gate: a floor it could not read must never pass as no floor, or as a low one.
read_floor() {
    local file=$1 prefix=$2
    read_tracked "$file"
    if [ "$tracked" -eq 0 ]; then
        floor=100000
        return 0
    fi
    significant
    case $mode in 100644 | 100755) ;; *) lines="" ;; esac
    if ! grep -q -x -E "$prefix-[0-9]{4}" <<<"$lines" || [ "$(grep -c '' <<<"$lines")" -ne 1 ] ||
        [ "$((10#${lines#"$prefix"-}))" -lt 1 ]; then
        echo "leak-gate: $file is not a regular file naming one $prefix ID above 0000" >&2
        exit 1
    fi
    floor=$((10#${lines#"$prefix"-}))
}
read_floor bugs/FLOOR bug
bug_floor=$floor
read_floor plans/FLOOR plan
plan_floor=$floor

found=0

report() {
    local rule=$1 lines=$2
    [ -n "$lines" ] || return 0
    found=1
    while IFS= read -r line; do
        printf 'leak: %s: %s\n' "$rule" "$line"
    done <<<"$lines"
}

# Sets $out to the lines in $1 and $2, each line once, in byte order.
join_matches() {
    out=$(printf '%s\n%s\n' "$1" "$2" | LC_ALL=C sort -u | LC_ALL=C sed '/^$/d')
}

# Sets $out to grep's matches over a text, the same way as grep_index below.
grep_text() {
    local text=$1 a b status
    shift
    a=$(grep "$@" <<<"$text")
    status=$?
    [ "$status" -le 1 ] || { echo "leak-gate: grep failed (exit $status)" >&2; exit 1; }
    b=$(LC_ALL=C grep "$@" <<<"$text")
    status=$?
    [ "$status" -le 1 ] || { echo "leak-gate: grep failed (exit $status)" >&2; exit 1; }
    join_matches "$a" "$b"
}

# A user name is any run of characters up to a separator, a space, or the punctuation that ends a
# path in prose, so a name that is not ASCII is caught too.
name="[^][:space:]/\\\\<>\"'\`(){}|*?:,;[]+"
home_re='(/(Users|home)/|[A-Za-z]:\\\\?Users\\\\?)'"$name"
alice_re=':(/(Users|home)/|[A-Za-z]:\\\\?Users\\\\?)alice$'
claude_re='(~|[$]HOME|[$][{]HOME[}])/[.]claude'

# A folder's first character, as a user name's above but never a `.`, which starts a dot-folder.
folder="[^].[:space:]/\\\\<>\"'\`(){}|*?:,;[]"
home_folder_re='(~|[$]HOME|[$][{]HOME[}])/'"$folder"
env_home_re='env![[:space:]]*\([[:space:]]*"HOME"[[:space:]]*\)[[:space:]]*,[[:space:]]*"/'"$folder"

# An ID, after the start of a line or a character that is not a letter or digit, so `_` separates
# words.  Matched with LC_ALL=C, byte for byte, so a letter that is not ASCII separates words too,
# and with -o, so each match ends in the ID it found, binary files included.
id_re='(^|[^[:alnum:]])(bug|plan)-[0-9]{3,4}'

# Prints each line of $1 whose ID, at its end, is not four digits at or above its series' floor.
below_floor() {
    local line f re='(bug|plan)-([0-9]+)$'
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        if ! [[ $line =~ $re ]]; then
            printf '%s\n' "$line"
            continue
        fi
        case ${BASH_REMATCH[1]} in bug) f=$bug_floor ;; *) f=$plan_floor ;; esac
        if [ "${#BASH_REMATCH[2]}" -ne 4 ] || [ "$((10#${BASH_REMATCH[2]}))" -lt "$f" ]; then
            printf '%s\n' "$line"
        fi
    done <<<"$1"
}

# The private list, as one whole-word pattern per name in $words, or $words empty.  What an empty
# list means is said after the scan.  Only a proven "no such file" (ENOENT) is absence; anything
# else this lstat cannot answer is a list the gate could not read.  Bash cannot see errno, so perl
# looks.
patterns="" words="" word_args=()
if [ "$generic_only" -eq 0 ]; then
    perl -e 'exit(lstat($ARGV[0]) ? 0 : $!{ENOENT} ? 1 : 2)' -- "$list"
    case $? in
        0) [ -r "$list" ] || { echo "leak-gate: cannot read the private list $list" >&2; exit 1; }
           patterns=$(grep -v -E '^[[:space:]]*(#|$)' "$list" | sed $'s/\r$//')
           [ $? -le 1 ] || { echo "leak-gate: cannot read the private list $list" >&2; exit 1; } ;;
        1) [ "$explicit" -eq 0 ] || { echo "leak-gate: LEAK_GATE_PATTERNS names $list, which does not exist" >&2; exit 1; } ;;
        *) echo "leak-gate: cannot tell whether the private list $list exists" >&2; exit 1 ;;
    esac
    if [ -n "$patterns" ]; then
        # A name is a whole word, and `_` separates words, as in a Rust file name or identifier;
        # `-w` would count `_` as part of the word.
        words=$(printf '%s\n' "$patterns" | sed 's/.*/(^|[^[:alnum:]])(&)([^[:alnum:]]|$)/') ||
            { echo "leak-gate: sed failed over the private list" >&2; exit 1; }
        # As arguments, not a pipe: each search reads them twice (grep_index).
        while IFS= read -r line; do word_args+=(-e "$line"); done <<<"$words"
    fi
fi

# Sets $out to git grep's matches over the scope.  git grep exits 1 for "no match" and above 1
# when it failed, which must never read as clean.  Each search runs twice, in the caller's locale and
# byte for byte (LC_ALL=C), and the matches are joined: in a UTF-8 locale a line holding a byte that
# is not UTF-8 matches nothing, in git grep and in macOS's grep, while in C `-i` folds only ASCII.
grep_index() {
    local a b status
    a=$(git grep --cached --no-color -n "$@" "${scope[@]}")
    status=$?
    [ "$status" -le 1 ] || { echo "leak-gate: git grep failed (exit $status)" >&2; exit 1; }
    b=$(LC_ALL=C git grep --cached --no-color -n "$@" "${scope[@]}")
    status=$?
    [ "$status" -le 1 ] || { echo "leak-gate: git grep failed (exit $status)" >&2; exit 1; }
    join_matches "$a" "$b"
}

scan_index() {
    local line n match hits path_list
    scope=(-- .)
    read_tracked .leak-gate-exclude
    significant
    if [ -n "$lines" ]; then
        while IFS= read -r line; do
            scope+=(":(exclude,literal)$line")
        done <<<"$lines"
        echo "leak-gate: not scanning what .leak-gate-exclude lists: $(tr '\n' ' ' <<<"$lines")" >&2
    fi

    # A tracked file's path is published too.  Unquoted, so a name that is not ASCII stays itself.
    paths=$(git -c core.quotePath=false ls-files --cached "${scope[@]}") || { echo "leak-gate: git ls-files failed" >&2; exit 1; }
    if [ -z "$paths" ]; then
        all=$(git ls-files --cached) || { echo "leak-gate: git ls-files failed" >&2; exit 1; }
        [ -z "$all" ] || { echo "leak-gate: .leak-gate-exclude leaves nothing to scan" >&2; exit 1; }
    fi

    grep_index -o -E "$home_re"
    report "absolute home path" "$(printf '%s\n' "$out" | grep -v -E "$alice_re")"

    grep_index -E "$claude_re"
    report "path into the home .claude folder" "$out"

    grep_index -o -E -e "$home_folder_re" -e "$env_home_re"
    report "path from the home directory" "$out"

    LC_ALL=C grep_index -a -o -E "$id_re"
    report "bug or plan ID citation" "$(below_floor "$out")"

    # grep -n numbers the matches by path, so each is reported with its path.
    LC_ALL=C grep_text "$paths" -a -n -o -E "$id_re"
    path_list=()
    while IFS= read -r line; do path_list+=("$line"); done <<<"$paths"
    hits=""
    while IFS=: read -r n match; do
        [ -n "$n" ] && hits+="${path_list[n - 1]}:$match"$'\n'
    done <<<"$out"
    report "bug or plan ID in a path" "$(below_floor "$hits")"

    # A refused kind of file, by the end of its name, outside the folders allowed it.
    if [ -n "$refuse_exts" ]; then
        local ext_re="" e d p allowed
        while IFS= read -r e; do
            [ -n "$e" ] && ext_re+="${ext_re:+|}${e//./\\.}"
        done <<<"$refuse_exts"
        grep_text "$paths" -a -i -E "\\.($ext_re)\$"
        hits=""
        while IFS= read -r p; do
            [ -n "$p" ] || continue
            allowed=0
            while IFS= read -r d; do
                [ -n "$d" ] || continue
                case $p in "$d"/*) allowed=1; break ;; esac
            done <<<"$allow_dirs"
            [ "$allowed" -eq 1 ] || hits+="$p"$'\n'
        done <<<"$out"
        report "refused file type" "$hits"
    fi

    if [ -n "$words" ]; then
        grep_index -i -E "${word_args[@]}"
        report "private name" "$out"
        grep_text "$paths" -a -i -E "${word_args[@]}"
        report "private name in a path" "$out"
    fi
}

# Prints each line of $2 after `$1:`.
label() {
    local line
    while IFS= read -r line; do
        [ -z "$line" ] || printf '%s:%s\n' "$1" "$line"
    done <<<"$2"
}

# Scans the text $2, a message, with both layers, reporting each finding as `$1:<line>:...`.  Every
# grep takes the text as text (-a): GNU grep would otherwise print nothing for a line holding a byte
# that is not UTF-8, and exit 0.
scan_text() {
    local where=$1 text=$2
    grep_text "$text" -a -n -o -E "$home_re"
    report "absolute home path" "$(label "$where" "$(printf '%s\n' "$out" | grep -a -v -E "$alice_re")")"

    grep_text "$text" -a -n -E "$claude_re"
    report "path into the home .claude folder" "$(label "$where" "$out")"

    grep_text "$text" -a -n -o -E -e "$home_folder_re" -e "$env_home_re"
    report "path from the home directory" "$(label "$where" "$out")"

    LC_ALL=C grep_text "$text" -a -n -o -E "$id_re"
    report "bug or plan ID citation" "$(label "$where" "$(below_floor "$out")")"

    if [ -n "$words" ]; then
        grep_text "$text" -a -n -i -E "${word_args[@]}"
        report "private name" "$(label "$where" "$out")"
    fi
}

# Scans every line of the message file $target, in the header's terms.  bash would drop a NUL from
# the text, and join the words on either side of it, so a NUL becomes a line break first.
scan_message() {
    local text
    text=$(cat -- "$target" | LC_ALL=C tr '\0' '\n') || { echo "leak-gate: cannot read the message $target" >&2; exit 1; }
    scan_text message "$text"
}

# The message of the commit or tag object $1, raw, as a push sends it: replace refs ignored, the
# headers dropped, and a NUL read as a line break, as in scan_message.  tr and sed work on bytes
# (LC_ALL=C), since a message need not be valid UTF-8.
object_message() {
    git --no-replace-objects cat-file "$2" "$1" | LC_ALL=C tr '\0' '\n' | LC_ALL=C sed '1,/^$/d'
}

# Scans the messages of the commits in $target, and of the annotated tags that point to them.
scan_range() {
    local shallow commits c text tags type object ref o t chain status
    shallow=$(git rev-parse --is-shallow-repository) || { echo "leak-gate: git rev-parse failed" >&2; exit 1; }
    if [ "$shallow" != false ]; then
        echo "leak-gate: this is a shallow clone, whose history stops early; fetch all of it (in CI, actions/checkout with fetch-depth: 0)" >&2
        exit 4
    fi
    commits=$(git --no-replace-objects rev-list "$target" --) || { echo "leak-gate: git cannot list $target" >&2; exit 1; }
    [ -n "$commits" ] || echo "leak-gate: $target holds no commits" >&2
    for c in $commits; do
        text=$(object_message "$c" commit) || { echo "leak-gate: cannot read commit $c" >&2; exit 1; }
        scan_text "commit ${c:0:12}" "$text"
    done
    tags=$(git --no-replace-objects for-each-ref --format='%(objecttype) %(objectname) %(refname)' refs/tags) ||
        { echo "leak-gate: git for-each-ref failed" >&2; exit 1; }
    while read -r type object ref; do
        [ "$type" = tag ] || continue
        # A tag of a tag publishes both messages, so the chain is walked to the object it ends at.
        # Each tag object's first header line names the object it points to.
        chain="" o=$object
        while :; do
            t=$(git --no-replace-objects cat-file -t "$o") || { echo "leak-gate: cannot read an object of tag $ref" >&2; exit 1; }
            [ "$t" = tag ] || break
            chain+=" $o"
            o=$(git --no-replace-objects cat-file tag "$o" | LC_ALL=C sed -n '1s/^object //p') ||
                { echo "leak-gate: cannot read an object of tag $ref" >&2; exit 1; }
            [ -n "$o" ] || { echo "leak-gate: tag $ref does not name the object it points to" >&2; exit 1; }
        done
        # A tag of a tree or a blob points to no commit, so to none in the range.
        [ "$t" = commit ] || continue
        grep -q -x -F -e "$o" <<<"$commits"
        status=$?
        [ "$status" -le 1 ] || { echo "leak-gate: grep failed (exit $status)" >&2; exit 1; }
        [ "$status" -eq 0 ] || continue
        for o in $chain; do
            text=$(object_message "$o" tag) || { echo "leak-gate: cannot read tag $ref" >&2; exit 1; }
            scan_text "tag ${ref#refs/tags/}" "$text"
        done
    done <<<"$tags"
}

case $command in
    index) scan_index ;;
    message) scan_message ;;
    range) scan_range ;;
esac

if [ "$generic_only" -eq 1 ]; then
    echo "leak-gate: --generic-only: scanned the generic layer only" >&2
elif [ -z "$words" ]; then
    if [ "$named" -eq 1 ]; then
        echo "leak-gate: .leak-gate.toml names the private list $list_key, and ~/.config/leak-gate/lists/$list_key.txt does not exist or holds no pattern; create it, or pass --generic-only where no list can be" >&2
        exit 4
    fi
    echo "leak-gate: no private patterns at $list; scanned the generic layer only" >&2
    [ "$require_private" -eq 0 ] || exit 4
fi

if [ "$found" -eq 1 ]; then
    echo "leak-gate: replace each reference above with the reason it stands for" >&2
    exit 3
fi
